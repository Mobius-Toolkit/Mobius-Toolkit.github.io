    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--sl-color-white);
  }
  h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--sl-color-white);
  }
  ol {
    margin: 0;
    padding-left: 1.5rem;
  }
  li {
    padding-left: 0.5rem;
    margin-bottom: 2rem;
  }
  p {
    max-width: 65ch;
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.6;
  }
  code {
    font-family: inherit;
    font-weight: 600;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    font-weight: 600;
  }
  a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
